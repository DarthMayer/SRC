      "valid": true,
      "displayName": "Estrai testo dal DDT",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-media",
        "pieceVersion": "1.0.0",
        "actionName": "pdf.convertToText",
        "input": {
          "pdfUrl": "{{ trigger[\"file\"] }}"
        }
      }
    },
    {
      "name": "057cade5-37dd-4945-8881-ce675d797737",
      "valid": true,
      "displayName": "Leggi i dati del DDT",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-openai",
        "pieceVersion": "1.0.0",
        "actionName": "ai.ask",
        "input": {
          "input": "{{ caec9576-adfc-4ce6-b1aa-9ed0e72ba7d9[\"content\"] }}",
          "output": {
            "type": "object",
            "required": [
              "code",
              "name",
              "lot",
              "ddt",
              "date",
              "quantity",
              "plate",
              "count",
              "note"
            ],
            "properties": {
              "ddt": {
                "type": "string"
              },
              "lot": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "count": {
                "type": "number"
              },
              "plate": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              }
            }
          },
          "prompt": "Leggi il testo del DDT CASSE. Restituisci un oggetto strutturato con questi campi obbligatori: code, name, lot, ddt, quantity, date, plate e count. code è il CODICE MANGIME; name deve essere uguale al codice se non è presente una denominazione; lot è il LOTTO; ddt è il NUMERO DDT; date è la DATA CARICO in formato ISO; plate è la TARGA; count è il NUMERO CASSA. quantity deve essere un numero in quintali, convertendo la quantità in TM moltiplicandola per 10 quando il documento usa TM, perché la tabella memorizza i quintali e visualizza i TM. Usa esclusivamente valori presenti nel documento, senza inventare. Per i campi testuali assenti restituisci una stringa vuota.",
          "outputType": "structuredoutput"
        }
      }
    },

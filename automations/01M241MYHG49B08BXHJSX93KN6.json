  "flowTitle": "Importa DDT PDF - CASSE",
  "trigger": {
    "type": "FORM",
    "displayName": "Carica DDT CASSE",
    "settings": {
      "description": "",
      "inputs": [
        {
          "id": "file",
          "title": "DDT PDF",
          "description": "Trascina qui il DDT in PDF o seleziona un file.",
          "type": "file"
        }
      ],
      "isEndPageEnabled": false
    }
  },
  "actions": [

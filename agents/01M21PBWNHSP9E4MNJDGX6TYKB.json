      "id": "Controlla le giacenze",
      "text": "Controlla le giacenze",
      "prompt": "Qual è la situazione attuale delle giacenze per categoria?"
    },
    {
      "id": "Riepiloga le EPAL",
      "text": "Riepiloga le EPAL",
      "prompt": "Quante EPAL risultano spedite, rientrate e ancora fuori?"
    },
    {
      "id": "Vedi gli scarichi",
      "text": "Vedi gli scarichi",
      "prompt": "Quali scarichi sono programmati nei prossimi giorni?"
    }
  ],
